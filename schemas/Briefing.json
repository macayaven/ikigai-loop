{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "One proposed item in the ``actions`` section.",
      "properties": {
        "commitment_id": {
          "minLength": 1,
          "title": "Commitment Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "love",
            "good_at",
            "world_needs",
            "paid_for",
            "limit",
            "contrast"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "build",
            "write",
            "read",
            "apply",
            "outreach",
            "walk",
            "rest",
            "music",
            "social",
            "plan",
            "checkin"
          ],
          "title": "Kind",
          "type": "string"
        },
        "proposed_end": {
          "format": "date-time",
          "title": "Proposed End",
          "type": "string"
        },
        "proposed_start": {
          "format": "date-time",
          "title": "Proposed Start",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "commitment_id",
        "kind",
        "text",
        "dimension",
        "proposed_start",
        "proposed_end"
      ],
      "title": "Action",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One prose statement plus its evidence (facts and/or metric refs).",
      "properties": {
        "fact_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "metric_refs": {
          "items": {
            "$ref": "#/$defs/MetricRef"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "MetricRef": {
      "additionalProperties": false,
      "description": "A numeric value cited by a claim, reconciled against a snapshot.",
      "properties": {
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric_id",
        "value"
      ],
      "title": "MetricRef",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "description": "One typed section; its ``type`` is its identity (no ``id`` field).",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "title": "Actions",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "type": {
          "enum": [
            "overall_state",
            "since_last",
            "working",
            "not_working",
            "actions"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One gated briefing for one profile at one slot.",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "parent_briefing_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Briefing Id"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "slot": {
      "format": "date-time",
      "title": "Slot",
      "type": "string"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "profile_id",
    "subject_id",
    "slot"
  ],
  "title": "Briefing",
  "type": "object"
}
