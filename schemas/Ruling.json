{
  "$defs": {
    "Proposal": {
      "additionalProperties": false,
      "description": "One labelled offer as shown on a card.",
      "properties": {
        "commitment_id": {
          "minLength": 1,
          "title": "Commitment Id",
          "type": "string"
        },
        "label": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Label",
          "type": "string"
        },
        "policy_alternative": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Alternative"
        },
        "policy_pick": {
          "minLength": 1,
          "title": "Policy Pick",
          "type": "string"
        },
        "profile_id": {
          "enum": [
            "builder",
            "disconnect"
          ],
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "label",
        "profile_id",
        "commitment_id",
        "policy_pick"
      ],
      "title": "Proposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One tap on one card, with the card's slot and bucket attached.",
  "properties": {
    "bucket": {
      "enum": [
        "afternoon",
        "evening",
        "night"
      ],
      "title": "Bucket",
      "type": "string"
    },
    "card_id": {
      "minLength": 1,
      "title": "Card Id",
      "type": "string"
    },
    "proposals": {
      "items": {
        "$ref": "#/$defs/Proposal"
      },
      "title": "Proposals",
      "type": "array"
    },
    "slot": {
      "format": "date-time",
      "title": "Slot",
      "type": "string"
    },
    "target": {
      "enum": [
        "A",
        "B",
        "neither",
        "wrong",
        "why"
      ],
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "card_id",
    "slot",
    "bucket",
    "proposals",
    "target"
  ],
  "title": "Ruling",
  "type": "object"
}
