{
  "pack_id": "bikes",
  "title": "Bike-share operations",
  "note": "Historical public data (Capital Bikeshare, Washington D.C., 2011 and 2012, via the UCI Machine Learning Repository). Not a deployment and not a user.",
  "goal": {
    "id": "meet-demand",
    "text": "Keep enough bikes on the street for the riders who show up."
  },
  "sources": {
    "day": {
      "path": "day.csv",
      "sha256": "f247059a558cb90c6cb7dfc0356d3c7cacaee6660d3a18f03f91400e0cedeb97",
      "date_column": "dteday"
    },
    "hour": {
      "path": "hour.csv",
      "sha256": "a6a595f505922c9b6ec438301a362c4a4187824c33359c3c327e3ed054f35039",
      "date_column": "dteday"
    }
  },
  "window": {
    "days": 7,
    "starts_on": "monday",
    "period_phrase": "week of {start}"
  },
  "daily_metrics": [
    {
      "prefix": "total_rentals",
      "source": "day",
      "column": "cnt",
      "op": "sum",
      "labels": [
        "total",
        "rentals"
      ],
      "unit": "count"
    },
    {
      "prefix": "casual_rentals",
      "source": "day",
      "column": "casual",
      "op": "sum",
      "labels": [
        "casual",
        "rentals"
      ],
      "unit": "count"
    },
    {
      "prefix": "registered_rentals",
      "source": "day",
      "column": "registered",
      "op": "sum",
      "labels": [
        "registered",
        "rentals"
      ],
      "unit": "count"
    }
  ],
  "window_metrics": [
    {
      "id": "week_total_rentals",
      "op": "sum",
      "of": "total_rentals",
      "labels": [
        "total",
        "rentals"
      ],
      "unit": "count"
    },
    {
      "id": "busy_days",
      "op": "count_above",
      "of": "total_rentals",
      "above": 100,
      "labels": [
        "busy",
        "days"
      ],
      "unit": "days"
    }
  ],
  "identities": [
    {
      "kind": "columns_sum",
      "source": "day",
      "parts": [
        "casual",
        "registered"
      ],
      "total": "cnt"
    },
    {
      "kind": "daily_matches",
      "metric": "total_rentals",
      "source": "hour",
      "column": "cnt"
    }
  ],
  "commitments": [
    {
      "id": "review-capacity",
      "text": "Review bike capacity for the coming week.",
      "when": {
        "metric": "busy_days",
        "op": ">=",
        "value": 1
      }
    },
    {
      "id": "continue-monitoring",
      "text": "Keep monitoring; no capacity change this week.",
      "when": {
        "metric": "busy_days",
        "op": "==",
        "value": 0
      }
    }
  ],
  "facts": {
    "busy_rule": "A busy day is a day with more total rentals than the declared threshold.",
    "source": "UCI Bike Sharing dataset, day.csv and hour.csv, CC BY 4.0."
  }
}
