# read at the CLI edge only
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Directory holding private criteria lists (never committed). The briefing
# gate reads only deny-terms.txt inside it: one private term per line,
# blank lines and lines starting with # are ignored, and any line starting
# with "- " or "* " fails the load closed. Matching is case-insensitive;
# terms of 3 characters or fewer match whole words only. A missing file, a
# file with no terms, or a non-UTF-8 file also fails closed.
HIDDEN_CRITERIA_DIR=
# Path to a JSON list of commitments (the only registry actions may
# schedule from). Unset or unreadable fails the gate closed.
IKIGAI_COMMITMENTS_FILE=
ICAL_URL_PERSONAL=
ICAL_URL_HOME=
GITHUB_USER=
GITHUB_TOKEN=
IKIGAI_SUBJECT_ID=
